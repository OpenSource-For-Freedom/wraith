<Window x:Class="WRAITH.WalkthroughWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WRAITH  ·  Tour"
        Width="350" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

  <Grid>

    <!-- Gold arrow — points left at the exact UI element. 24×40px, pulsing. -->
    <Path x:Name="ArrowLeft"
          Data="M 0,20 L 24,0 L 24,40 Z"
          Margin="0,24,0,0"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          Visibility="Collapsed">
      <Path.Fill>
        <SolidColorBrush Color="#D4AF37"/>
      </Path.Fill>
      <Path.Effect>
        <DropShadowEffect Color="#D4AF37" BlurRadius="14" ShadowDepth="0" Opacity="1.0"/>
      </Path.Effect>
      <Path.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="1.0" To="0.25" Duration="0:0:0.55"
                               AutoReverse="True"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Path.Triggers>
    </Path>

    <!-- Main card — margin-left leaves room for the arrow -->
    <Border x:Name="Card"
            BorderBrush="#2A1A5A" BorderThickness="1" CornerRadius="8"
            Background="{StaticResource BrWindowBackground}"
            Margin="26,0,0,0">
      <Border.Effect>
        <DropShadowEffect Color="#4D2090" BlurRadius="28" ShadowDepth="0" Opacity="0.7"/>
      </Border.Effect>

      <StackPanel>

        <!-- Title bar -->
        <Border Background="#05051A" CornerRadius="8,8,0,0"
                Height="30" MouseLeftButtonDown="TitleBar_MouseDown">
          <Grid Margin="10,0">
            <TextBlock x:Name="StepLabel"
                       Text="Step 1 of 5"
                       Foreground="#3E5568" FontSize="10"
                       VerticalAlignment="Center" FontFamily="Segoe UI"
                       HorizontalAlignment="Left"/>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#3E5568" FontSize="10" Cursor="Hand"
                    Padding="6,2" Click="Skip_Click"/>
          </Grid>
        </Border>

        <!-- Body -->
        <StackPanel Margin="18,16,18,16">

          <TextBlock x:Name="TitleText"
                     FontSize="15" FontWeight="Bold"
                     FontFamily="Segoe UI" Margin="0,0,0,10">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#D4AF37" Offset="0"/>
                <GradientStop Color="#E8F4FF" Offset="0.55"/>
                <GradientStop Color="#D4AF37" Offset="1"/>
              </LinearGradientBrush>
            </TextBlock.Foreground>
          </TextBlock>

          <TextBlock x:Name="BodyText"
                     TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12"
                     Foreground="#A8C8E8" LineHeight="20"/>

          <TextBlock x:Name="NoteText"
                     TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="11"
                     Foreground="#4A5A6A" LineHeight="18" Margin="0,10,0,0"
                     Visibility="Collapsed"/>

          <Grid Margin="0,16,0,0">
            <Button x:Name="SkipBtn" Content="Skip tour"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#3E5568" FontSize="10" Cursor="Hand"
                    Padding="0,4" Click="Skip_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BackBtn" Content="Back"
                      Style="{StaticResource GhostButton}"
                      FontSize="11" Padding="12,5"
                      Margin="0,0,6,0" IsEnabled="False"
                      Click="Back_Click"/>
              <Button x:Name="NextBtn" Content="Next"
                      Style="{StaticResource SpellButton}"
                      FontSize="11" Padding="14,5"
                      Click="Next_Click"/>
            </StackPanel>
          </Grid>

        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>

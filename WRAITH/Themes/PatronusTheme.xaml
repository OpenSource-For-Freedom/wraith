<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       WRAITH Â· Deathly Hallows â€” Dark Teal / Fog / Gold
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->

  <!-- Palette -->
  <Color x:Key="ColVoid">#08081A</Color>
  <Color x:Key="ColAbyss">#0B0B20</Color>
  <Color x:Key="ColFog">#0F0F2E</Color>
  <Color x:Key="ColDeepTeal">#1A0D3D</Color>
  <Color x:Key="ColTeal">#2E1A5E</Color>
  <Color x:Key="ColTealGlow">#7B3FE4</Color>
  <Color x:Key="ColMist">#A8C8E8</Color>
  <Color x:Key="ColGold">#D4AF37</Color>
  <Color x:Key="ColGoldDim">#8B7420</Color>
  <Color x:Key="ColText">#C8D8E8</Color>
  <Color x:Key="ColTextBright">#E8F4FF</Color>
  <Color x:Key="ColCritical">#FF2D55</Color>
  <Color x:Key="ColHigh">#FF6B35</Color>
  <Color x:Key="ColMedium">#FFD700</Color>
  <Color x:Key="ColLow">#4FC3F7</Color>
  <Color x:Key="ColInfo">#9E9E9E</Color>
  <Color x:Key="ColPanelBorder">#2A1A5A</Color>
  <Color x:Key="ColGlassBorder">#507B3FE4</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="BrVoid"           Color="{StaticResource ColVoid}"/>
  <SolidColorBrush x:Key="BrFog"            Color="{StaticResource ColFog}"/>
  <SolidColorBrush x:Key="BrTeal"           Color="{StaticResource ColTeal}"/>
  <SolidColorBrush x:Key="BrTealGlow"       Color="{StaticResource ColTealGlow}"/>
  <SolidColorBrush x:Key="BrGold"           Color="{StaticResource ColGold}"/>
  <SolidColorBrush x:Key="BrCritical"       Color="{StaticResource ColCritical}"/>
  <SolidColorBrush x:Key="BrHigh"           Color="{StaticResource ColHigh}"/>
  <SolidColorBrush x:Key="BrMedium"         Color="{StaticResource ColMedium}"/>
  <SolidColorBrush x:Key="BrLow"            Color="{StaticResource ColLow}"/>
  <SolidColorBrush x:Key="BrInfo"           Color="{StaticResource ColInfo}"/>
  <SolidColorBrush x:Key="BrPanelBorder"    Color="{StaticResource ColPanelBorder}"/>
  <SolidColorBrush x:Key="BrTransparent"    Color="Transparent"/>

  <!-- Legacy key aliases so existing XAML bindings keep working -->
  <SolidColorBrush x:Key="BrDeepVoid"       Color="{StaticResource ColVoid}"/>
  <SolidColorBrush x:Key="BrAbyss"          Color="{StaticResource ColAbyss}"/>
  <SolidColorBrush x:Key="BrDarkMagic"      Color="{StaticResource ColFog}"/>
  <SolidColorBrush x:Key="BrPurpleShadow"   Color="{StaticResource ColDeepTeal}"/>
  <SolidColorBrush x:Key="BrPatronusSilver" Color="{StaticResource ColText}"/>
  <SolidColorBrush x:Key="BrPatronusGlow"   Color="{StaticResource ColMist}"/>
  <SolidColorBrush x:Key="BrPatronusCore"   Color="{StaticResource ColTextBright}"/>
  <SolidColorBrush x:Key="BrGryffindorGold" Color="{StaticResource ColGold}"/>
  <SolidColorBrush x:Key="BrGoldDim"        Color="{StaticResource ColGoldDim}"/>
  <SolidColorBrush x:Key="BrGlassWhite"     Color="{StaticResource ColTextBright}"/>
  <SolidColorBrush x:Key="BrFrostWhite"     Color="{StaticResource ColText}"/>
  <SolidColorBrush x:Key="BrAqua"           Color="{StaticResource ColTealGlow}"/>
  <SolidColorBrush x:Key="BrAquaLight"      Color="{StaticResource ColMist}"/>
  <SolidColorBrush x:Key="BrAquaFrost"      Color="{StaticResource ColGold}"/>
  <SolidColorBrush x:Key="BrGlass"          Color="#1A2E1A5E"/>
  <SolidColorBrush x:Key="BrGlassBorder"    Color="{StaticResource ColGlassBorder}"/>
  <SolidColorBrush x:Key="BrSkyDeep"        Color="{StaticResource ColVoid}"/>

  <!-- System popup brushes -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"        Color="#0D0D28"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="#0D0D28"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#302E1A5E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8F4FF"/>

  <!-- Window background: deep void to purple -->
  <LinearGradientBrush x:Key="BrWindowBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#08081A" Offset="0.0"/>
    <GradientStop Color="#1A0D3D" Offset="0.5"/>
    <GradientStop Color="#08081A" Offset="1.0"/>
  </LinearGradientBrush>

  <!-- Header: purple shimmer -->
  <LinearGradientBrush x:Key="BrHeaderBackground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#1A0D3D" Offset="0.0"/>
    <GradientStop Color="#2E1A5E" Offset="0.5"/>
    <GradientStop Color="#1A0D3D" Offset="1.0"/>
  </LinearGradientBrush>

  <!-- Button fill â€” teal glass -->
  <LinearGradientBrush x:Key="BrScanButton" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#601A4A36" Offset="0"/>
    <GradientStop Color="#300A2018" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrScanButtonHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#902A7A56" Offset="0"/>
    <GradientStop Color="#501A4A36" Offset="1"/>
  </LinearGradientBrush>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Typography
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <FontFamily x:Key="FntWraith">Segoe UI</FontFamily>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Window
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Style x:Key="WraithWindow" TargetType="Window">
    <Setter Property="Background"  Value="{StaticResource BrWindowBackground}"/>
    <Setter Property="Foreground"  Value="{StaticResource BrPatronusSilver}"/>
    <Setter Property="FontFamily"  Value="{StaticResource FntWraith}"/>
    <Setter Property="FontSize"    Value="13"/>
  </Style>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Spell Panel â€” glassy dark teal bubble
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Style x:Key="SpellPanel" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#30A8C8E8" Offset="0.0"/>
          <GradientStop Color="#100F0F2E" Offset="0.5"/>
          <GradientStop Color="#180F0F2E" Offset="1.0"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#80A8C8E8" Offset="0.0"/>
          <GradientStop Color="#252E1A5E" Offset="1.0"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="14"/>
    <Setter Property="Padding"         Value="12"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#7B3FE4" BlurRadius="24" ShadowDepth="0" Opacity="0.3"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Buttons â€” full-body Aero glass, Deathly Hallows teal+gold
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Style x:Key="SpellButton" TargetType="Button">
    <Setter Property="Foreground"      Value="{StaticResource BrPatronusCore}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="FontWeight"      Value="SemiBold"/>
    <Setter Property="Padding"         Value="18,8"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" BorderThickness="1" CornerRadius="12"
                  ClipToBounds="True" SnapsToDevicePixels="True">
  <!-- Aero glass: white gloss top half, dark purple bottom half -->
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <!-- True iOS liquid glass: thin specular top, mostly transparent body, rim light bottom -->
                <GradientStop Color="#60FFFFFF" Offset="0.00"/>
                <GradientStop Color="#18FFFFFF" Offset="0.18"/>
                <GradientStop Color="#08FFFFFF" Offset="0.45"/>
                <GradientStop Color="#123D1C7A" Offset="0.55"/>
                <GradientStop Color="#225A2EA8" Offset="0.80"/>
                <GradientStop Color="#38A8C8E8" Offset="1.00"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEA8C8E8" Offset="0.0"/>
                <GradientStop Color="#407B3FE4" Offset="0.5"/>
                <GradientStop Color="#70A8C8E8" Offset="1.0"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
              <DropShadowEffect Color="#7B3FE4" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}">
              <ContentPresenter.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
              </ContentPresenter.Effect>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#80FFFFFF" Offset="0.00"/>
                    <GradientStop Color="#28FFFFFF" Offset="0.18"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#1A5A2EA8" Offset="0.55"/>
                    <GradientStop Color="#337B3FE4" Offset="0.80"/>
                    <GradientStop Color="#55C8D8E8" Offset="1.00"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Setter TargetName="Bd" Property="BorderBrush">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE8F0FF" Offset="0.0"/>
                    <GradientStop Color="#80A8C8E8" Offset="1.0"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#800A2018" Offset="0.00"/>
                    <GradientStop Color="#601A4A36" Offset="1.00"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SpellButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" BorderThickness="1" CornerRadius="12"
                  ClipToBounds="True" SnapsToDevicePixels="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F0FFFFFF" Offset="0.00"/>
                <GradientStop Color="#BBFFEEEE" Offset="0.45"/>
                <GradientStop Color="#88FFAAAA" Offset="0.49"/>
                <GradientStop Color="#00600F1E" Offset="0.50"/>
                <GradientStop Color="#CCAA2030" Offset="0.51"/>
                <GradientStop Color="#EEDD3050" Offset="0.75"/>
                <GradientStop Color="#FF801828" Offset="1.00"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CCE03040" Offset="0.0"/>
                <GradientStop Color="#60AA2030" Offset="1.0"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
              <DropShadowEffect Color="#E03040" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}">
              <ContentPresenter.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.6"/>
              </ContentPresenter.Effect>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource SpellButton}">
    <Setter Property="Foreground"  Value="{StaticResource BrGold}"/>
    <Setter Property="FontSize"    Value="10"/>
    <Setter Property="Padding"     Value="10,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#60C8A84A" Offset="0"/>
                <GradientStop Color="#20806020" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A0C8A84A" Offset="0"/>
                <GradientStop Color="#40806020" Offset="1"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
              <DropShadowEffect Color="#C8A84A" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SpellButton}">
    <Setter Property="Foreground"  Value="{StaticResource BrPatronusSilver}"/>
    <Setter Property="FontSize"    Value="12"/>
    <Setter Property="Padding"     Value="12,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" BorderThickness="1" CornerRadius="10"
                  ClipToBounds="True" SnapsToDevicePixels="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#45FFFFFF" Offset="0.00"/>
                <GradientStop Color="#12FFFFFF" Offset="0.18"/>
                <GradientStop Color="#06FFFFFF" Offset="0.45"/>
                <GradientStop Color="#0E2E1A5E" Offset="0.55"/>
                <GradientStop Color="#183D1C7A" Offset="0.80"/>
                <GradientStop Color="#28A8C8E8" Offset="1.00"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CCA8C8E8" Offset="0"/>
                <GradientStop Color="#307B3FE4" Offset="1"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
              <DropShadowEffect Color="#7B3FE4" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}">
              <ContentPresenter.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
              </ContentPresenter.Effect>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#60FFFFFF" Offset="0.00"/>
                    <GradientStop Color="#1AFFFFFF" Offset="0.18"/>
                    <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
                    <GradientStop Color="#185A2EA8" Offset="0.55"/>
                    <GradientStop Color="#287B3FE4" Offset="1.00"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       TextBox
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Style TargetType="TextBox">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#28253A2E" Offset="0"/>
          <GradientStop Color="#18101810" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground"        Value="{StaticResource BrPatronusSilver}"/>
    <Setter Property="BorderThickness"   Value="1"/>
    <Setter Property="CaretBrush"        Value="{StaticResource BrTealGlow}"/>
    <Setter Property="SelectionBrush"    Value="#401A4A36"/>
    <Setter Property="Padding"           Value="8,5"/>
    <Setter Property="FontSize"          Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}" BorderThickness="1">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#80C8A84A" Offset="0"/>
                <GradientStop Color="#302A7A56" Offset="1"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
              <DropShadowEffect Color="#2A7A56" BlurRadius="6" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="#C8A84A" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       ComboBox
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Style x:Key="WraithComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource BrPatronusSilver}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding"    Value="8,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#28C8A84A"/>
        <Setter Property="Foreground" Value="{StaticResource BrPatronusCore}"/>
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="#301A4A36"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#401A4A36"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WraithComboToggle" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="Transparent"/>
              <Path Grid.Column="1" x:Name="Arrow"
                    Data="M 0 0 L 4 4 L 8 0 Z"
                    Fill="{StaticResource BrGold}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#201A4A36"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#301A4A36"/>
              <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrPatronusCore}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground"          Value="{StaticResource BrPatronusSilver}"/>
    <Setter Property="BorderThickness"     Value="1"/>
    <Setter Property="Padding"             Value="8,4"/>
    <Setter Property="FontSize"            Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ItemContainerStyle"  Value="{StaticResource WraithComboBoxItem}"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#30253A2E" Offset="0"/>
          <GradientStop Color="#18101810" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton"
                          Style="{StaticResource WraithComboToggle}"
                          Background="{TemplateBinding Background}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False">
              <ToggleButton.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#70C8A84A" Offset="0"/>
                  <GradientStop Color="#25C8A84A" Offset="1"/>
                </LinearGradientBrush>
              </ToggleButton.BorderBrush>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="10,0,24,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>
            <Popup x:Name="Popup" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   PopupAnimation="Slide"
                   Focusable="False">
              <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border x:Name="DropDownBorder" CornerRadius="0,0,8,8" BorderThickness="1">
                  <Border.Background>
                    <SolidColorBrush Color="#E80A1410"/>
                  </Border.Background>
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#40C8A84A" Offset="0"/>
                      <GradientStop Color="#20C8A84A" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                </Border>
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Grid>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       ListView / GridView
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Style TargetType="ListView">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground"      Value="{StaticResource BrPatronusSilver}"/>
    <Setter Property="FontSize"        Value="12"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing"     Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding"    Value="4,3"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource BrPatronusSilver}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#401A4A36"/>
        <Setter Property="Foreground" Value="{StaticResource BrPatronusCore}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#20C8A84A"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Foreground"      Value="{StaticResource BrGold}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding"         Value="8,5"/>
    <Setter Property="FontWeight"      Value="SemiBold"/>
    <Setter Property="FontSize"        Value="11"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#301A4A36" Offset="0"/>
          <GradientStop Color="#100A1410" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <SolidColorBrush Color="#30C8A84A"/>

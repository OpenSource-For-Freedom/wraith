<Project>
  <PropertyGroup>
    <AssemblyName>WRAITH</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>F:\wraith\WRAITH\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>WRAITH</_TargetAssemblyProjectName>
    <RootNamespace>WRAITH</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ProductName>WRAITH — Expecto Patronum Threat Hunter</ProductName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <RootNamespace>WRAITH</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Suppress WinForms designer warnings in WPF project -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\wraith.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
    <PackageReference Include="Velopack" Version="1.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Listed as Content (not None) so the .ico is available during the publish  -->
    <!-- Win32 PE icon embedding pass; ApplicationIcon above sets the actual icon. -->
    <Content Include="Assets\wraith.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Copy automation scripts next to the exe so AutomationMenuService can find them -->
  <ItemGroup>
    <Content Include="..\automation\**\*">
      <Link>automation\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Ship the Python scanner next to the exe so the Velopack publish (which
       only takes what dotnet publish emits) finds scanner/scanner.py at
       runtime. Without this, every scheduled task / persistence listener
       registered from a Velopack install fails silently. The portable ZIP
       still gets scanner/ via the workflow's separate Copy-Item — that step
       becomes redundant but harmless. test_*.py excluded so the pytest
       suites don't ship to end users. -->
  <ItemGroup>
    <Content Include="..\scanner\**\*" Exclude="..\scanner\**\__pycache__\**;..\scanner\**\*.pyc;..\scanner\test_*.py">
      <Link>scanner\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
